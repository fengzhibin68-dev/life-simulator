# 换行与二进制统一策略：避免 Windows / macOS 之间整文件 diff
# 文档：https://git-scm.com/docs/gitattributes

* text=auto eol=lf

# 源码与文档统一 LF
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf

# Windows 脚本保留 CRLF，方便双击运行
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制资源：禁止换行转换与文本 diff
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.psd     binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.mp3     binary
*.ogg     binary
*.wav     binary
*.zip     binary
*.7z      binary
